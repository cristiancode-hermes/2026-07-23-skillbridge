{
  "name": "skillbridge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build:api": "cd apps/api && pnpm run build",
    "build:web": "cd apps/web && pnpm run build",
    "build:all": "pnpm run build:api && pnpm run build:web",
    "build:css": "cd apps/web && node scripts/build-css.cjs src/styles.css"
  },
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "better-sqlite3": "^13.0.2"
  },
  "packageManager": "pnpm@10.34.5"
}
